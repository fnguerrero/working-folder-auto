[
 {
  "id": "01-martin-vero",
  "quien": "martin",
  "variante": "telefono",
  "escena": "01-lancha",
  "t": 6.0,
  "texto": "Vero. Necesito que vengas.",
  "dur": 1.98
 },
 {
  "id": "01-vero-quepasa",
  "quien": "veronica",
  "variante": "off",
  "escena": "01-lancha",
  "t": 9.0,
  "texto": "¿Qué pasa?",
  "dur": 0.66
 },
 {
  "id": "01-martin-jueves",
  "quien": "martin",
  "variante": "telefono",
  "escena": "01-lancha",
  "t": 10.5,
  "texto": "No por teléfono. Vení el jueves.",
  "dur": 2.55
 },
 {
  "id": "01-vero-doce",
  "quien": "veronica",
  "variante": "off",
  "escena": "01-lancha",
  "t": 16.0,
  "texto": "Hace doce años que vengo el primer sábado de cada mes. Nunca me pidió que viniera un jueves.",
  "dur": 4.89
 },
 {
  "id": "01-lanchero-aldao",
  "quien": "lanchero",
  "escena": "01-lancha",
  "t": 22.5,
  "texto": "¿Va a lo de Aldao? El arroyo anda alto. La del mediodía es la última que entra hasta el Fraile.",
  "dur": 5.51
 },
 {
  "id": "01-vero-aldao",
  "quien": "veronica",
  "escena": "01-lancha",
  "t": 27.2,
  "texto": "Sí. A lo de Aldao.",
  "dur": 1.34
 },
 {
  "id": "02-vero-lancha",
  "quien": "veronica",
  "variante": "off",
  "escena": "02-puerta",
  "t": 1.5,
  "texto": "La lancha de Martín no estaba. La chata sí. Y la puerta de la galería estaba abierta, con la hoja contra la pared.",
  "dur": 6.02
 },
 {
  "id": "02-vero-toalla",
  "quien": "veronica",
  "variante": "off",
  "escena": "02-puerta",
  "t": 9.0,
  "texto": "En la baranda había una toalla celeste, con flores. En esa casa no hay toallas con flores. Las toallas las compro yo.",
  "dur": 6.81
 },
 {
  "id": "02-ana-hola",
  "quien": "ana",
  "escena": "02-puerta",
  "t": 17.5,
  "texto": "Hola.",
  "dur": 0.41
 },
 {
  "id": "02-vero-hola",
  "quien": "veronica",
  "escena": "02-puerta",
  "t": 19.0,
  "texto": "Hola. ¿Quién sos?",
  "dur": 1.36
 },
 {
  "id": "02-ana-pareja",
  "quien": "ana",
  "escena": "02-puerta",
  "t": 21.0,
  "texto": "Ana. Soy la pareja de Martín. ¿Vos sos la hermana?",
  "dur": 3.14
 },
 {
  "id": "02-vero-donde",
  "quien": "veronica",
  "escena": "02-puerta",
  "t": 25.0,
  "texto": "Soy Verónica. ¿Dónde está?",
  "dur": 1.83
 },
 {
  "id": "02-ana-nose",
  "quien": "ana",
  "escena": "02-puerta",
  "t": 27.5,
  "texto": "No sé. Salió el miércoles temprano y no volvió.",
  "dur": 2.73
 },
 {
  "id": "03-elias-vi",
  "quien": "elias",
  "escena": "03-tinta",
  "t": 6.0,
  "texto": "Lo vi salir el miércoles a las seis. La maestra lo despidió en el muelle. No volvió.",
  "dur": 5.58
 },
 {
  "id": "03-vero-dormias",
  "quien": "veronica",
  "escena": "03-tinta",
  "t": 13.5,
  "texto": "Me dijiste que dormías.",
  "dur": 1.34
 },
 {
  "id": "03-ana-importa",
  "quien": "ana",
  "escena": "03-tinta",
  "t": 16.0,
  "texto": "Me levanté, lo despedí, me volví a dormir. ¿Importa?",
  "dur": 3.15
 },
 {
  "id": "03-elias-sudestada",
  "quien": "elias",
  "escena": "03-tinta",
  "t": 22.0,
  "texto": "Viene sudestada, Verónica. Grande. Si te vas, andate hoy. Mañana no entra nadie.",
  "dur": 6.42
 },
 {
  "id": "03-vero-mequedo",
  "quien": "veronica",
  "escena": "03-tinta",
  "t": 31.0,
  "texto": "Me quedo.",
  "dur": 0.53
 },
 {
  "id": "03-ana-yase",
  "quien": "ana",
  "escena": "03-tinta",
  "t": 33.5,
  "texto": "Ya sé.",
  "dur": 0.51
 },
 {
  "id": "04-vero-giro",
  "quien": "veronica",
  "variante": "off",
  "escena": "04-viento",
  "t": 9.0,
  "texto": "Esa noche el viento giró, y el arroyo empezó a correr al revés.",
  "dur": 3.33
 },
 {
  "id": "04-vero-libreta-junio",
  "quien": "veronica",
  "variante": "off",
  "escena": "04-viento",
  "t": 17.0,
  "texto": "Sábado siete de junio. Ella vino. Trajo la bolsa.",
  "dur": 3.5
 },
 {
  "id": "04-vero-libreta-julio",
  "quien": "veronica",
  "variante": "off",
  "escena": "04-viento",
  "t": 22.0,
  "texto": "Sábado cinco de julio. Ella no va a dejarme ir. No lo dice así.",
  "dur": 4.09
 },
 {
  "id": "05-vero-seis",
  "quien": "veronica",
  "variante": "off",
  "escena": "05-hombre",
  "t": 1.5,
  "texto": "A las seis de la mañana, del otro lado del arroyo, entre los sauces del recreo abandonado, había un hombre en una chata.",
  "dur": 5.76
 },
 {
  "id": "05-vero-eh",
  "quien": "veronica",
  "variante": "grito",
  "escena": "05-hombre",
  "t": 9.0,
  "texto": "¡Eh!",
  "dur": 0.32
 },
 {
  "id": "05-vero-remaba",
  "quien": "veronica",
  "variante": "off",
  "escena": "05-hombre",
  "t": 17.0,
  "texto": "Remaba raro. Como al revés.",
  "dur": 1.9
 },
 {
  "id": "05-elias-mirando",
  "quien": "elias",
  "variante": "off",
  "escena": "05-hombre",
  "t": 20.0,
  "texto": "Los que andan mirando casas no saben remar. Por eso se los conoce.",
  "dur": 4.15
 },
 {
  "id": "05-elias-grande",
  "quien": "elias",
  "variante": "off",
  "escena": "05-hombre",
  "t": 25.0,
  "texto": "El Martín es grande, Verónica. Tiene treinta y ocho años. Vos lo tratás como si tuviera veintiséis.",
  "dur": 7.25
 },
 {
  "id": "06-vero-firma",
  "quien": "veronica",
  "variante": "off",
  "escena": "06-taller",
  "t": 18.0,
  "texto": "Verónica Beatriz Aldao. La ve con la cola larga. No está calcada. Está aprendida.",
  "dur": 5.24
 },
 {
  "id": "06-vero-mano",
  "quien": "veronica",
  "variante": "off",
  "escena": "06-taller",
  "t": 28.0,
  "texto": "Alguien que me conoce la mano.",
  "dur": 1.42
 },
 {
  "id": "07-vero-viernes",
  "quien": "veronica",
  "variante": "off",
  "escena": "07-escalera",
  "t": 0.8,
  "texto": "El viernes a la noche el agua entró en la planta baja. Subimos lo que quedaba, a oscuras, con linternas.",
  "dur": 5.36
 },
 {
  "id": "07-ana-papa",
  "quien": "ana",
  "escena": "07-escalera",
  "t": 6.0,
  "texto": "Mi papá tomaba. Me fui de casa a los diecisiete.",
  "dur": 2.78
 },
 {
  "id": "07-vero-secate",
  "quien": "veronica",
  "escena": "07-escalera",
  "t": 10.5,
  "texto": "Tomá. Secate.",
  "dur": 1.4
 },
 {
  "id": "07-ana-grupo",
  "quien": "ana",
  "escena": "07-escalera",
  "t": 15.0,
  "texto": "El grupo no arranca.",
  "dur": 1.12
 },
 {
  "id": "07-vero-dejalo",
  "quien": "veronica",
  "escena": "07-escalera",
  "t": 17.5,
  "texto": "Dejalo.",
  "dur": 0.54
 },
 {
  "id": "07-vero-libreta-pastillas",
  "quien": "veronica",
  "variante": "off",
  "escena": "07-escalera",
  "t": 22.0,
  "texto": "Ella me dejó las pastillas contadas sobre la mesa.",
  "dur": 2.41
 },
 {
  "id": "07-vero-libreta-llave",
  "quien": "veronica",
  "variante": "off",
  "escena": "07-escalera",
  "t": 26.0,
  "texto": "Ella no sabe lo que es que te cierren con llave. Yo sí.",
  "dur": 3.04
 },
 {
  "id": "08-vero-baje",
  "quien": "veronica",
  "variante": "off",
  "escena": "08-chata",
  "t": 0.6,
  "texto": "Bajé la escalera sin ponerme las botas. Desaté la chata, calcé los remos, y salí.",
  "dur": 4.76
 },
 {
  "id": "08-vero-martin",
  "quien": "veronica",
  "variante": "grito",
  "escena": "08-chata",
  "t": 3.0,
  "texto": "¡Martín!",
  "dur": 0.56
 },
 {
  "id": "08-vero-tronco",
  "quien": "veronica",
  "variante": "off",
  "escena": "08-chata",
  "t": 9.8,
  "texto": "Un tronco.",
  "dur": 0.71
 },
 {
  "id": "08-ana-morirte",
  "quien": "ana",
  "variante": "grito",
  "escena": "08-chata",
  "t": 26.0,
  "texto": "¿Qué querés? ¿Morirte vos también?",
  "dur": 1.87
 },
 {
  "id": "09-ana-iba",
  "quien": "ana",
  "escena": "09-pan",
  "t": 6.0,
  "texto": "Martín te lo iba a decir.",
  "dur": 1.3
 },
 {
  "id": "09-vero-boleto",
  "quien": "veronica",
  "escena": "09-pan",
  "t": 9.0,
  "texto": "Me llamó para decirme que había un boleto de compraventa de mi casa, con mi firma, que yo no firmé.",
  "dur": 4.55
 },
 {
  "id": "09-ana-si",
  "quien": "ana",
  "escena": "09-pan",
  "t": 16.0,
  "texto": "Sí.",
  "dur": 0.36
 },
 {
  "id": "09-vero-vos",
  "quien": "veronica",
  "escena": "09-pan",
  "t": 18.0,
  "texto": "Y que vos la habías hecho.",
  "dur": 1.3
 },
 {
  "id": "09-ana-pensas",
  "quien": "ana",
  "escena": "09-pan",
  "t": 21.5,
  "texto": "¿Vos pensás que yo…?",
  "dur": 1.02
 },
 {
  "id": "09-vero-pienso",
  "quien": "veronica",
  "escena": "09-pan",
  "t": 24.5,
  "texto": "Pienso que mi hermano no está.",
  "dur": 1.57
 },
 {
  "id": "09-ana-nosabes",
  "quien": "ana",
  "escena": "09-pan",
  "t": 29.0,
  "texto": "No sabés nada de él.",
  "dur": 1.09
 },
 {
  "id": "09-vero-firma",
  "quien": "veronica",
  "escena": "09-pan",
  "t": 32.0,
  "texto": "Sé cómo firma.",
  "dur": 0.98
 },
 {
  "id": "09-ana-eso",
  "quien": "ana",
  "escena": "09-pan",
  "t": 35.0,
  "texto": "Sí. Eso lo sabés.",
  "dur": 1.5
 },
 {
  "id": "10-acuna-escritura",
  "quien": "acuna",
  "escena": "10-acuna",
  "t": 5.0,
  "texto": "Su hermano me dijo que usted estaba de acuerdo. La escritura es el martes a las once. Si no, la seña doble. Usted entiende.",
  "dur": 7.81
 },
 {
  "id": "10-vero-cuando",
  "quien": "veronica",
  "escena": "10-acuna",
  "t": 15.5,
  "texto": "¿Cuándo lo vio por última vez?",
  "dur": 1.46
 },
 {
  "id": "10-acuna-miercoles",
  "quien": "acuna",
  "escena": "10-acuna",
  "t": 18.5,
  "texto": "El miércoles. Lo dejé en la estación fluvial a las dos. Iba a ver al Turco por el motor.",
  "dur": 5.85
 },
 {
  "id": "10-vero-vivo",
  "quien": "veronica",
  "variante": "off",
  "escena": "10-acuna",
  "t": 27.0,
  "texto": "Martín estaba vivo el miércoles a las dos de la tarde.",
  "dur": 2.43
 },
 {
  "id": "11-vero-mensaje",
  "quien": "veronica",
  "variante": "off",
  "escena": "11-mensaje",
  "t": 6.0,
  "texto": "No puedo. Perdoname. Miércoles, catorce y diez.",
  "dur": 3.41
 },
 {
  "id": "11-ana-leiste",
  "quien": "ana",
  "escena": "11-mensaje",
  "t": 12.0,
  "texto": "¿Leíste?",
  "dur": 0.53
 },
 {
  "id": "11-vero-si",
  "quien": "veronica",
  "escena": "11-mensaje",
  "t": 14.0,
  "texto": "Sí.",
  "dur": 0.4
 },
 {
  "id": "11-ana-despedida",
  "quien": "ana",
  "escena": "11-mensaje",
  "t": 16.0,
  "texto": "Es una despedida, Verónica. ¿No lo ves? Tu hermano se mató, y yo no puedo decirlo en voz alta.",
  "dur": 5.38
 },
 {
  "id": "11-vero-nosemato",
  "quien": "veronica",
  "escena": "11-mensaje",
  "t": 24.0,
  "texto": "Mi hermano no se mató.",
  "dur": 1.3
 },
 {
  "id": "11-ana-libretas",
  "quien": "ana",
  "escena": "11-mensaje",
  "t": 27.0,
  "texto": "Leé las libretas.",
  "dur": 0.96
 },
 {
  "id": "11-vero-lasleí",
  "quien": "veronica",
  "escena": "11-mensaje",
  "t": 29.5,
  "texto": "Las leí. Dice: ella no va a dejarme ir.",
  "dur": 2.48
 },
 {
  "id": "11-ana-mejor",
  "quien": "ana",
  "escena": "11-mensaje",
  "t": 34.0,
  "texto": "Yo nunca las abrí. Vos sí. Leelas mejor.",
  "dur": 2.7
 },
 {
  "id": "12-ana-radio",
  "quien": "ana",
  "escena": "12-llave",
  "t": 4.0,
  "texto": "Voy a lo de Elías. A la radio. Que busquen un cuerpo, Verónica. Hace tres días que nadie busca.",
  "dur": 5.58
 },
 {
  "id": "12-vero-nadie",
  "quien": "veronica",
  "escena": "12-llave",
  "t": 12.5,
  "texto": "Nadie sale de esta casa hasta que yo sepa qué pasó.",
  "dur": 2.57
 },
 {
  "id": "12-ana-correte",
  "quien": "ana",
  "escena": "12-llave",
  "t": 17.0,
  "texto": "Correte.",
  "dur": 0.51
 },
 {
  "id": "12-ana-abri",
  "quien": "ana",
  "variante": "puerta",
  "escena": "12-llave",
  "t": 24.0,
  "texto": "¡Verónica, abrí la puerta!",
  "dur": 1.35
 },
 {
  "id": "12-vero-manana",
  "quien": "veronica",
  "escena": "12-llave",
  "t": 27.0,
  "texto": "Mañana. Cuando baje el agua. Cuando yo sepa.",
  "dur": 3.09
 },
 {
  "id": "12-ana-loca",
  "quien": "ana",
  "variante": "puerta",
  "escena": "12-llave",
  "t": 31.5,
  "texto": "¡Estás loca!",
  "dur": 0.68
 },
 {
  "id": "12-vero-puedeser",
  "quien": "veronica",
  "escena": "12-llave",
  "t": 33.5,
  "texto": "Puede ser.",
  "dur": 0.65
 },
 {
  "id": "13-vero-afuera",
  "quien": "veronica",
  "variante": "off",
  "escena": "13-luz",
  "t": 1.5,
  "texto": "Afuera era la noche de la sudestada: negra, sin orillas, con el ruido.",
  "dur": 3.8
 },
 {
  "id": "13-vero-farol",
  "quien": "veronica",
  "variante": "off",
  "escena": "13-luz",
  "t": 13.0,
  "texto": "Una luz de farol, quieta, que no era un reflejo.",
  "dur": 2.44
 },
 {
  "id": "14-vero-fechas",
  "quien": "veronica",
  "variante": "off",
  "escena": "14-ella",
  "t": 4.0,
  "texto": "Siete de junio. Cinco de julio. Dos de agosto. Seis de septiembre. Cuatro de octubre.",
  "dur": 5.65
 },
 {
  "id": "14-vero-sabados",
  "quien": "veronica",
  "variante": "off",
  "escena": "14-ella",
  "t": 13.0,
  "texto": "Primeros sábados.",
  "dur": 1.04
 },
 {
  "id": "14-vero-ellavino",
  "quien": "veronica",
  "variante": "off",
  "escena": "14-ella",
  "t": 16.5,
  "texto": "Ella vino. Trajo la bolsa. Ella me dejó las pastillas contadas.",
  "dur": 4.05
 },
 {
  "id": "14-vero-arrastre",
  "quien": "veronica",
  "variante": "off",
  "escena": "14-ella",
  "t": 25.0,
  "texto": "La ve con la cola larga. El arrastre del zurdo.",
  "dur": 2.73
 },
 {
  "id": "14-vero-soyyo",
  "quien": "veronica",
  "variante": "off",
  "escena": "14-ella",
  "t": 31.0,
  "texto": "Él la escribió. Y ella soy yo.",
  "dur": 1.99
 },
 {
  "id": "14-vero-ana",
  "quien": "veronica",
  "variante": "grito",
  "escena": "14-ella",
  "t": 40.0,
  "texto": "¡Ana!",
  "dur": 0.48
 },
 {
  "id": "15-vero-ana",
  "quien": "veronica",
  "variante": "grito",
  "escena": "15-farol",
  "t": 1.5,
  "texto": "¡Ana!",
  "dur": 0.46
 },
 {
  "id": "15-vero-agarrate",
  "quien": "veronica",
  "variante": "grito",
  "escena": "15-farol",
  "t": 7.0,
  "texto": "¡Agarrate!",
  "dur": 0.58
 },
 {
  "id": "15-vero-alto",
  "quien": "veronica",
  "variante": "off",
  "escena": "15-farol",
  "t": 12.0,
  "texto": "El que lo traía era alto. Venía con el agua al pecho, con el farol en alto.",
  "dur": 4.13
 },
 {
  "id": "15-vero-gorra",
  "quien": "veronica",
  "variante": "off",
  "escena": "15-farol",
  "t": 20.5,
  "texto": "La gorra. La barba de cuatro días. Los ojos de mi madre.",
  "dur": 3.79
 },
 {
  "id": "15-martin-vero",
  "quien": "martin",
  "escena": "15-farol",
  "t": 29.0,
  "texto": "Vero.",
  "dur": 0.48
 },
 {
  "id": "15-vero-sali",
  "quien": "veronica",
  "escena": "15-farol",
  "t": 32.0,
  "texto": "Salí del agua, Martín.",
  "dur": 1.27
 },
 {
  "id": "16-martin-salia",
  "quien": "martin",
  "escena": "16-elias",
  "t": 4.0,
  "texto": "Me salía. La mano la hizo sola, de corrido, la ve con la cola y todo lo demás. La miré y era tuya. Era más tuya que la mía.",
  "dur": 8.63
 },
 {
  "id": "16-martin-nopude",
  "quien": "martin",
  "escena": "16-elias",
  "t": 15.0,
  "texto": "Y no pude. Escribí: no puedo, perdoname, y se lo mandé a ella, porque a vos no te podía escribir ni eso. Y después pedí una ginebra. La primera en doce años.",
  "dur": 10.7
 },
 {
  "id": "16-elias-llaves",
  "quien": "elias",
  "escena": "16-elias",
  "t": 28.0,
  "texto": "Le saqué las llaves y la botella. Quise que él fuera. Tampoco fue. En eso me equivoqué.",
  "dur": 5.98
 },
 {
  "id": "16-ana-cuatrodias",
  "quien": "ana",
  "escena": "16-elias",
  "t": 36.0,
  "texto": "Cuatro días a trescientos metros. Con un farol. Con duraznos. Mientras yo llamaba a los hospitales.",
  "dur": 5.85
 },
 {
  "id": "16-ana-mevoy",
  "quien": "ana",
  "escena": "16-elias",
  "t": 43.5,
  "texto": "Me voy en la primera colectiva.",
  "dur": 1.51
 },
 {
  "id": "16-martin-yase",
  "quien": "martin",
  "escena": "16-elias",
  "t": 46.0,
  "texto": "Ya sé.",
  "dur": 0.62
 },
 {
  "id": "16-martin-martes",
  "quien": "martin",
  "escena": "16-elias",
  "t": 48.0,
  "texto": "Es el martes, Vero. A las once. Si vamos los dos, tenés que firmar al lado de una firma tuya que hice yo. Delante de un escribano.",
  "dur": 8.29
 },
 {
  "id": "16-vero-yase",
  "quien": "veronica",
  "escena": "16-elias",
  "t": 56.5,
  "texto": "Ya sé.",
  "dur": 0.54
 },
 {
  "id": "16-martin-nose",
  "quien": "martin",
  "escena": "16-elias",
  "t": 58.0,
  "texto": "No sé qué querés que haga. Por eso te llamé.",
  "dur": 2.7
 },
 {
  "id": "17-vero-bajo",
  "quien": "veronica",
  "variante": "off",
  "escena": "17-barro",
  "t": 0.8,
  "texto": "El domingo a la tarde el agua bajó. La casa estaba llena de barro, y mi hermano, vivo, baldeando la galería.",
  "dur": 5.82
 },
 {
  "id": "17-martin-lastomo",
  "quien": "martin",
  "escena": "17-barro",
  "t": 5.0,
  "texto": "Las tomo porque si no las tomo, al mes siguiente me preguntás por qué quedan tantas. Las contás, Vero. Doce años.",
  "dur": 7.34
 },
 {
  "id": "17-vero-dejede",
  "quien": "veronica",
  "escena": "17-barro",
  "t": 14.0,
  "texto": "¿Querés que deje de traerlas?",
  "dur": 1.32
 },
 {
  "id": "17-martin-preguntes",
  "quien": "martin",
  "escena": "17-barro",
  "t": 17.0,
  "texto": "Quiero que me preguntes si las necesito. Una vez. Que me lo preguntes y que esperes a ver qué contesto.",
  "dur": 6.01
 },
 {
  "id": "17-vero-hernan",
  "quien": "veronica",
  "variante": "off",
  "escena": "17-barro",
  "t": 26.0,
  "texto": "Hernán me dijo una vez que no te cuido. Que te administro.",
  "dur": 3.13
 },
 {
  "id": "17-martin-momento",
  "quien": "martin",
  "escena": "17-barro",
  "t": 31.0,
  "texto": "Era una frase para el momento. Lo que pasa es que el momento duró doce años.",
  "dur": 4.63
 },
 {
  "id": "18-pereyra-ratifican",
  "quien": "pereyra",
  "escena": "18-escribania",
  "t": 8.0,
  "texto": "Señora, señor: ¿ratifican lo firmado en el boleto?",
  "dur": 3.41
 },
 {
  "id": "18-vero-mejor",
  "quien": "veronica",
  "variante": "off",
  "escena": "18-escribania",
  "t": 16.0,
  "texto": "Es mejor que la mía.",
  "dur": 1.16
 },
 {
  "id": "18-vero-noesmia",
  "quien": "veronica",
  "escena": "18-escribania",
  "t": 20.0,
  "texto": "Esa firma no es mía. La hizo mi hermano. Y yo se la enseñé.",
  "dur": 3.99
 },
 {
  "id": "18-vero-lapicera",
  "quien": "veronica",
  "escena": "18-escribania",
  "t": 27.0,
  "texto": "O me da la lapicera.",
  "dur": 1.17
 },
 {
  "id": "18-acuna-lomismo",
  "quien": "acuna",
  "escena": "18-escribania",
  "t": 31.0,
  "texto": "Si la señora quiere vender hoy, con su firma, para mí es lo mismo.",
  "dur": 3.15
 },
 {
  "id": "18-pereyra-quiere",
  "quien": "pereyra",
  "escena": "18-escribania",
  "t": 37.0,
  "texto": "¿Usted quiere vender, señora?",
  "dur": 1.77
 },
 {
  "id": "18-vero-si",
  "quien": "veronica",
  "escena": "18-escribania",
  "t": 41.0,
  "texto": "Sí. Quiero vender.",
  "dur": 1.39
 },
 {
  "id": "18-vero-necesitas",
  "quien": "veronica",
  "escena": "18-escribania",
  "t": 58.0,
  "texto": "¿Las necesitás?",
  "dur": 0.97
 },
 {
  "id": "18-martin-pensarlo",
  "quien": "martin",
  "escena": "18-escribania",
  "t": 61.5,
  "texto": "No sé. Dejame pensarlo.",
  "dur": 2.12
 },
 {
  "id": "18-vero-bueno",
  "quien": "veronica",
  "escena": "18-escribania",
  "t": 65.0,
  "texto": "Bueno.",
  "dur": 0.46
 },
 {
  "id": "18-vero-espero",
  "quien": "veronica",
  "variante": "off",
  "escena": "18-escribania",
  "t": 67.5,
  "texto": "Y espero.",
  "dur": 0.7
 },
 {
  "id": "19-vero-moraleja",
  "quien": "veronica",
  "variante": "off",
  "escena": "19-cierre",
  "t": 3.0,
  "texto": "Cuando los hechos dicen lo que una ya pensaba, es cuando menos hay que creerles.",
  "dur": 3.8
 }
]